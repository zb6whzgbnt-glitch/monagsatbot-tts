TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Optional alias:
# BOT_TOKEN=your_telegram_bot_token_here

# Gemini TTS (primary engine)
GEMINI_API_KEY=your_gemini_api_key_here
# TTS_MODEL=gemini-2.5-flash-preview-tts
# TTS_FALLBACK_MODEL=gemini-2.5-pro-preview-tts
# GEMINI_VOICE_MALE=Fenrir
# GEMINI_VOICE_FEMALE=Aoede
# GEMINI_TTS_TIMEOUT_SEC=90

# Optional Edge voice overrides (fallback engine):
# EDGE_VOICE_FEMALE=ar-SA-ZariyahNeural
# EDGE_VOICE_FEMALE_FALLBACK=ar-EG-SalmaNeural
# EDGE_VOICE_MALE=ar-SA-HamedNeural
# EDGE_VOICE_MALE_FALLBACK=ar-EG-ShakirNeural
# TTS_CHUNK_MIN=800
# TTS_CHUNK_MAX=1200
# PENDING_TTL_SEC=600

# Private bot: only these Telegram user IDs may use the bot (comma-separated)
ALLOWED_USER_IDS=8415608677
# PDF_MAX_BYTES=20971520
# PDF_LONG_WARN_CHARS=8000
# TXT_MAX_BYTES=20971520

# Fish Audio TTS (third engine)
FISH_API_KEY=your_fish_audio_api_key_here
# FISH_TTS_MODEL=s2.1-pro-free
# Optional Arabic-capable public voice IDs (empty = Fish auto voice)
# FISH_VOICE_MALE=55542ca9d06d4111977d1f06c905a3a5
# FISH_VOICE_FEMALE=f2acd2bec2db4cf1827172299c2900ef
# FISH_TTS_TIMEOUT_SEC=120

# Cohere (optional article generation module)
COHERE_API_KEY=your_cohere_api_key_here
# COHERE_MODEL=command-a-03-2025

# --- Render / webhook (production) ---
# On Render, RENDER_EXTERNAL_HOSTNAME is set automatically → webhook mode.
# Locally leave these unset to use long-polling.
# WEBHOOK_URL=https://your-service.onrender.com
# WEBHOOK_PATH=telegram
# WEBHOOK_SECRET=optional_random_secret_for_X-Telegram-Bot-Api-Secret-Token
# PORT=10000
